# Скопируйте этот файл в .env
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=ministral-8b-2512
MISTRAL_ALLOW_SMALL_FALLBACK=false
MISTRAL_EMBEDDING_MODEL=mistral-embed
DEMO_MODE=true

# Google Sheets — опционально для первого запуска.
# Можно указать JSON сервисного аккаунта одной строкой.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHARE_WITH_EMAIL=

# Локальная проверка смыслового сходства (CPU, без API)
LOCAL_EMBEDDING_ENABLED=true
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_CACHE_DIR=/models/fastembed
